<Window x:Class="CaboCam.Views.TwoFactorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Código de verificação" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Código de verificação" Style="{StaticResource CardTitle}"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Digite o código de 6 dígitos que a Apple mostrou nos seus dispositivos confiáveis."/>
        <TextBox x:Name="CodeBox" Margin="0,14,0,0" FontSize="20" MaxLength="6" HorizontalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Confirmar" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
