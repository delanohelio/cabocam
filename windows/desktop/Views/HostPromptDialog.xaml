<Window x:Class="CaboCam.Views.HostPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar por IP" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Conectar por IP" Style="{StaticResource CardTitle}"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Informe o endereço do iPhone (mesma rede Wi-Fi). A porta padrão é 7878. Exemplo: 192.168.0.25:7878"/>
        <TextBox x:Name="HostBox" Margin="0,14,0,0" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Conectar" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
