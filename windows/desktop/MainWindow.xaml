<Window x:Class="CaboCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaboCam" Icon="pack://application:,,,/Assets/CaboCam.ico" Width="1360" Height="840" MinWidth="1080" MinHeight="680"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: connection + camera ================= -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Conexão" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding LastError}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DeviceLine}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bateria" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding BatteryText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Térmica" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ThermalText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Latência" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding LatencyText}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Conectar por IP…" Command="{Binding ConnectByIpCommand}" Margin="0,0,8,0"/>
                            <Button Content="Usar USB" Command="{Binding UseUsbCommand}"
                                    Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,14,0,8"/>
                        <CheckBox Content="Iniciar transmissão automaticamente" IsChecked="{Binding AutoStart}"/>
                        <CheckBox Content="Iniciar minimizado" IsChecked="{Binding StartMinimized}"/>
                        <CheckBox Content="Fechar para a bandeja do sistema" IsChecked="{Binding CloseToTray}"
                                  ToolTip="Marcado: o X esconde a janela e a câmera CaboCam continua disponível. Desmarcado: o X encerra o CaboCam e remove a câmera."/>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,14,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding VcamBrush}" VerticalAlignment="Center" Margin="0,2,8,0"/>
                            <TextBlock Text="{Binding VcamText}" TextWrapping="Wrap" MaxWidth="270" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="Em uso por um aplicativo" Foreground="{StaticResource AccentHoverBrush}" FontSize="12"
                                   Margin="16,4,0,0" Visibility="{Binding VcamInUse, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Visibility="{Binding NeedsDriver, Converter={StaticResource BoolToVis}}" Margin="16,8,0,0">
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                       Text="Sem o driver, Teams, Zoom e outros apps não veem a câmera CaboCam. A instalação pede permissão de administrador uma vez."/>
                            <Button Content="Instalar driver da câmera (admin)" Command="{Binding InstallDriverCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding ControlsEnabled}">
                    <StackPanel>
                        <TextBlock Text="Câmera" Style="{StaticResource CardTitle}"/>

                        <TextBlock Text="Lente" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Cameras}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding CameraId, Mode=TwoWay}"/>

                        <TextBlock Text="Resolução e taxa de quadros" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding FormatKey, Mode=TwoWay}"/>

                        <TextBlock Text="Codec" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Codecs}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding CodecKey, Mode=TwoWay}"/>

                        <Grid Margin="0,10,0,4">
                            <TextBlock Text="Taxa de bits" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding BitrateLabel}" HorizontalAlignment="Right" FontSize="12"/>
                        </Grid>
                        <Slider Tag="bitrate" Minimum="2" Maximum="50" Value="{Binding BitrateMbps, Mode=TwoWay}"/>

                        <TextBlock Text="Orientação" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Orientations}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding OrientationKey, Mode=TwoWay}"/>

                        <CheckBox Content="Espelhar imagem" IsChecked="{Binding Mirror}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Content="{Binding StreamButtonText}"
                        Command="{Binding ToggleStreamCommand}" Padding="14,11" FontSize="14" Margin="0,0,0,12"/>

                <Border Style="{StaticResource Card}" DataContext="{Binding IosApp}">
                    <StackPanel>
                        <TextBlock Text="App do iPhone" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ExpiryBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                            <TextBlock Text="{Binding ExpiryText}" TextWrapping="Wrap" MaxWidth="270" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AccountText}" Style="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIndeterminate}" Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource ControlBrush}" BorderThickness="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Activity}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="Versão" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Releases}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="↻" ToolTip="Atualizar lista de versões" Margin="6,0,0,0"
                                    Padding="10,4" Command="{Binding RefreshReleasesCommand}"/>
                        </Grid>

                        <Button Content="Renovar / instalar versão" Command="{Binding InstallLatestCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Mostrar Modo Dev no iPhone" Command="{Binding RevealDevModeCommand}" Style="{StaticResource ChipButton}"
                                    ToolTip="Faz aparecer a opção Ajustes → Privacidade e Segurança → Modo de Desenvolvedor"/>
                            <Button Content="Instalar .ipa…" Command="{Binding InstallFromFileCommand}" Style="{StaticResource ChipButton}"/>
                            <Button Content="Entrar" Command="{Binding LoginCommand}" Style="{StaticResource ChipButton}"/>
                            <Button Content="Sair" Command="{Binding LogoutCommand}" Style="{StaticResource ChipButton}"/>
                            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource ChipButton}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{Binding HelpButtonText}" Command="{Binding ToggleHelpCommand}" Style="{StaticResource ChipButton}"/>
                        </WrapPanel>

                        <Border Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"
                                Padding="12,10" CornerRadius="8" Background="{StaticResource ControlBrush}">
                            <StackPanel>
                                <TextBlock Text="Antes de instalar (uma vez)" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="1. No iPhone: Ajustes → Privacidade e Segurança → Modo de Desenvolvedor → ativar. Se a opção não aparecer, clique em &quot;Mostrar Modo Dev no iPhone&quot;."/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="2. O iPhone reinicia. Desbloqueie e toque em &quot;Ativar&quot;."/>

                                <TextBlock Text="Depois de instalar (uma vez por Apple ID)" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Se o iPhone disser &quot;Desenvolvedor Corporativo Não Confiável&quot; (ou &quot;não confiável&quot;):"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="1. Ajustes → Geral → VPN e Gerenciamento de Dispositivo."/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="2. Em &quot;App de Desenvolvedor&quot;, toque no seu Apple ID."/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="3. Toque em &quot;Confiar&quot; e confirme. O iPhone precisa estar com internet."/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="4. Abra o CaboCam no iPhone e deixe-o em primeiro plano."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="As renovações de 7 dias usam o mesmo certificado e não pedem para confiar de novo."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= CENTER: preview ================= -->
        <Border Grid.Column="1" Background="#07080B" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" ClipToBounds="True" Margin="0,0,0,12">
            <Grid>
                <Image x:Name="PreviewImage" Source="{Binding PreviewSource}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" Cursor="Cross"
                       MouseLeftButtonDown="OnPreviewMouseDown"/>
                <TextBlock Text="Aguardando vídeo do iPhone…" Foreground="{StaticResource MutedBrush}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Canvas x:Name="TapLayer" IsHitTestVisible="False">
                    <Ellipse x:Name="TapRing" Width="48" Height="48" Stroke="#FACC15" StrokeThickness="2" Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="TapScale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="10,5"
                        CornerRadius="8" Background="#99000000" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverlayText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding OverlayText}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ================= RIGHT: adjustments ================= -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0">
            <Border Style="{StaticResource Card}" IsEnabled="{Binding ControlsEnabled}">
                <StackPanel>
                    <TextBlock Text="Ajustes" Style="{StaticResource CardTitle}"/>

                    <!-- Zoom -->
                    <Grid>
                        <TextBlock Text="Zoom" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ZoomLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider Tag="zoom" Minimum="0" Maximum="1" Value="{Binding ZoomPos, Mode=TwoWay}"
                            IsEnabled="{Binding ZoomEnabled}" Margin="0,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding ZoomPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource ChipButton}"
                                        Command="{Binding DataContext.ZoomPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Focus -->
                    <TextBlock Text="Foco" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding FocusOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding FocusMode, Mode=TwoWay}"/>
                    <Slider Tag="lens" Minimum="0" Maximum="1" Value="{Binding LensPosition, Mode=TwoWay}"
                            IsEnabled="{Binding LensEnabled}" Margin="0,8,0,0"/>
                    <TextBlock Text="Posição da lente (perto — longe)" Style="{StaticResource Muted}" FontSize="11"/>

                    <!-- Exposure -->
                    <TextBlock Text="Exposição" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding ExposureOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding ExposureMode, Mode=TwoWay}"/>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="ISO" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding IsoLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="exposure" Minimum="0" Maximum="1" Value="{Binding IsoPos, Mode=TwoWay}"
                            IsEnabled="{Binding ManualExposureEnabled}"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Obturador" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ShutterLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="exposure" Minimum="0" Maximum="1" Value="{Binding ShutterPos, Mode=TwoWay}"
                            IsEnabled="{Binding ManualExposureEnabled}"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Compensação de exposição" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding BiasLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="bias" Minimum="{Binding BiasMin}" Maximum="{Binding BiasMax}"
                            Value="{Binding ExposureBias, Mode=TwoWay}"/>

                    <!-- White balance -->
                    <TextBlock Text="Balanço de branco" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding WbOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding WhiteBalanceMode, Mode=TwoWay}"/>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Temperatura" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding TemperatureLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="wb" Minimum="2500" Maximum="8000" Value="{Binding Temperature, Mode=TwoWay}"
                            IsEnabled="{Binding ManualWbEnabled}"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Matiz" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding TintLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="wb" Minimum="-150" Maximum="150" Value="{Binding Tint, Mode=TwoWay}"
                            IsEnabled="{Binding ManualWbEnabled}"/>

                    <!-- Torch -->
                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Lanterna" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding TorchLabel}" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>
                    <Slider Tag="torch" Minimum="0" Maximum="1" Value="{Binding Torch, Mode=TwoWay}"
                            IsEnabled="{Binding TorchEnabled}" Margin="0,4,0,0"/>

                    <!-- Stabilization -->
                    <TextBlock Text="Estabilização" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                    <ComboBox ItemsSource="{Binding StabilizationOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding Stabilization, Mode=TwoWay}"/>

                    <CheckBox Content="HDR" IsChecked="{Binding Hdr}" IsEnabled="{Binding HdrEnabled}" Margin="0,14,0,0"/>
                    <CheckBox Content="Reforço em pouca luz" IsChecked="{Binding LowLightBoost}"
                              Visibility="{Binding LowLightVisible, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox Content="Center Stage" IsChecked="{Binding CenterStage}"
                              Visibility="{Binding CenterStageVisible, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox Content="Escurecer tela do iPhone" IsChecked="{Binding DimScreen}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
